+
+
+def paginate(items: Sequence[T], request: PageRequest) -> Page[T]:
+    """Cut one page out of a list that is already in memory (e.g. search results)."""
+    start = request.page * request.per_page
+    end = start + request.per_page
+    return Page(
+        items=list(items[start:end]),
+        page=request.page,
+        per_page=request.per_page,
+        total=len(items),
+    )
